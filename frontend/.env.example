# Copy to .env before running the client. .env itself is gitignored, so this
# file is the only record of which variables the build actually needs.
#
# Vite inlines anything prefixed VITE_ into the bundle at build time, so these
# values are public. Never put a secret here — the API keys, the RDS password
# and the AWS credentials all live server-side.

# Router basename. '/' unless the client is served from a sub-path.
VITE_APP_BASE_NAME=/

# Base URL of the Django REST API.
#
# Two rules, both of which the API client depends on:
#   * include the /api/v1 prefix — every route is mounted under it;
#   * no trailing slash — DRF routes here are registered as path("projects", ...)
#     with no trailing slash, so /projects/ is a 404 rather than a redirect.
#
# Local Django dev server:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Deployed (replace with the EC2 public DNS or load-balancer name; this must be
# https once the client is served over https, or the browser blocks the request
# as mixed content):
# VITE_API_BASE_URL=https://api.example.compute.amazonaws.com/api/v1
